  "estilo": ":root {\n  --ink: #221d3f; --green: #5b4bc4; --green-deep: #4536a0; --muted: #625d7d;\n  --line: #e2dff3; --sage: #f4f2fd; --sage-2: #ebe8fb; --paper: #f8f7fd;\n  --cream: #f1effb; --dark: #2b2357; --darker: #1a1538;\n  --shadow: 0 14px 40px rgba(34, 29, 63, 0.08);\n}\n.btn-nx-outline { border-color: #bdb4ec; }\n.btn-nx:hover { box-shadow: 0 10px 22px rgba(91, 75, 196, 0.22); }\n.plan-card .plan-badge { box-shadow: 0 6px 14px rgba(91, 75, 196, 0.25); }\n.plan-card.is-featured { box-shadow: 0 0 0 1.5px var(--green), 0 22px 44px rgba(34, 29, 63, 0.14); }\n.nx-stars { color: #b3a9e6; }\n.nav-dark-wrap { background: var(--darker); }\n.nav-dark-wrap::after { background: rgba(26, 21, 56, 0.74); }\n.nx-nav-dark { background: rgba(26, 21, 56, 0.72); }\n.nx-hero-slide { background-color: var(--paper); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(248, 247, 253, 0.9) 0%, rgba(248, 247, 253, 0.66) 32%, rgba(248, 247, 253, 0.14) 56%, rgba(248, 247, 253, 0) 70%);\n}\n.nx-footer-dark, .nx-footer-dark a { color: #f1effb; }\n.nx-footer-dark .muted { color: #bcb6dc; }\n.foot-cta {\n  background:\n    radial-gradient(60% 120% at 88% 0%, rgba(91, 75, 196, 0.5) 0%, transparent 60%),\n    radial-gradient(50% 110% at 6% 100%, rgba(255, 210, 94, 0.3) 0%, transparent 60%),\n    linear-gradient(115deg, var(--darker) 0%, var(--dark) 55%, var(--green-deep) 100%);\n}\n.foot-cta h2 .em { color: #ffd25e; }\n.foot-cta p, .foot-form input::placeholder, .foot-form-note { color: #bcb6dc; }\n.bk-steps .is-done button, .bk-pro:hover { border-color: #bdb4ec; }\n.bk-steps .is-done span { background: #e0dbf8; }\n.bk-pro[aria-pressed=\"true\"] { background: var(--sage); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(248, 247, 253, 0.95) 0%, rgba(248, 247, 253, 0.84) 36%, rgba(248, 247, 253, 0.32) 60%, rgba(248, 247, 253, 0) 80%);\n  }\n}\n.nav-dark-wrap::before { background-image: url(\"img/rubros/idiomas/hero.jpg\"); }"
