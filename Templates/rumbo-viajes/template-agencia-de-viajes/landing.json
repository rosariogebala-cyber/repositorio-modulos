  "estilo": ":root {\n  --ink: #0f2b3d; --green: #0b7a9a; --green-deep: #075c75; --muted: #557080;\n  --line: #d4e5ec; --sage: #edf6f9; --sage-2: #e1eff5; --paper: #f5f9fa;\n  --cream: #ebf3f6; --dark: #0e3447; --darker: #08202d;\n  --shadow: 0 14px 40px rgba(15, 43, 61, 0.08);\n}\n.btn-nx-outline { border-color: #9ccbdb; }\n.btn-nx:hover { box-shadow: 0 10px 22px rgba(11, 122, 154, 0.22); }\n.plan-card .plan-badge { box-shadow: 0 6px 14px rgba(11, 122, 154, 0.25); }\n.plan-card.is-featured { box-shadow: 0 0 0 1.5px var(--green), 0 22px 44px rgba(15, 43, 61, 0.14); }\n.nx-stars { color: #7fb6c9; }\n.nav-dark-wrap { background: var(--darker); }\n.nav-dark-wrap::after { background: rgba(8, 32, 45, 0.74); }\n.nx-nav-dark { background: rgba(8, 32, 45, 0.72); }\n.nx-hero-slide { background-color: var(--paper); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(245, 249, 250, 0.9) 0%, rgba(245, 249, 250, 0.66) 32%, rgba(245, 249, 250, 0.14) 56%, rgba(245, 249, 250, 0) 70%);\n}\n.nx-footer-dark, .nx-footer-dark a { color: #ebf3f6; }\n.nx-footer-dark .muted { color: #a9c3cf; }\n.foot-cta {\n  background:\n    radial-gradient(60% 120% at 88% 0%, rgba(11, 122, 154, 0.5) 0%, transparent 60%),\n    radial-gradient(50% 110% at 6% 100%, rgba(255, 197, 138, 0.3) 0%, transparent 60%),\n    linear-gradient(115deg, var(--darker) 0%, var(--dark) 55%, var(--green-deep) 100%);\n}\n.foot-cta h2 .em { color: #ffc58a; }\n.foot-cta p, .foot-form input::placeholder, .foot-form-note { color: #a9c3cf; }\n.bk-steps .is-done button, .bk-pro:hover { border-color: #9ccbdb; }\n.bk-steps .is-done span { background: #d5ebf2; }\n.bk-pro[aria-pressed=\"true\"] { background: var(--sage); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(245, 249, 250, 0.95) 0%, rgba(245, 249, 250, 0.84) 36%, rgba(245, 249, 250, 0.32) 60%, rgba(245, 249, 250, 0) 80%);\n  }\n}\n@media (max-width: 767.98px) { .nx-hero .nx-hero-slide { background-position: 74% center; } }\n.badge-new { background: #e8572e; font-weight: 700; letter-spacing: 0.02em; }\n.prod-price s { color: var(--muted); font-weight: 400; font-size: 0.85em; margin-left: 6px; }\n.promo-info { display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 13px; margin: 8px 0 14px; }\n.prod-feature { background: #dceff4; }\n.prod-feature-copy { background: linear-gradient(180deg, rgba(245, 249, 250, 0.82) 0%, rgba(245, 249, 250, 0) 44%); }\n.prod-feature-copy .nx-display .em { color: #e8572e; font-style: normal; font-weight: 600; }\n.gal-card .k { color: var(--green); font-weight: 600; }\n.cat-lead { max-width: 560px; }\n.cat-card { display: flex; align-items: center; gap: 14px; padding: 12px; color: inherit; text-decoration: none; }\n.cat-card img { flex: 0 0 42%; width: 42%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; }\n.cat-card > span { min-width: 0; }\n.cat-card h3 { font-size: clamp(1rem, 0.6rem + 0.6vw, 1.2rem); margin: 0 0 4px; overflow-wrap: anywhere; }\n.cat-card p { font-size: 14px; line-height: 1.45; }\n.cat-card:hover h3 { color: var(--green); }\n@media (max-width: 575.98px) {\n  .cat-card { flex-direction: column; align-items: stretch; gap: 10px; padding: 8px 8px 12px; }\n  .cat-card img { width: 100%; flex-basis: auto; aspect-ratio: 4 / 3; }\n  .cat-card > span { padding: 0 4px; }\n  .cat-card p { font-size: 13px; }\n}"
}