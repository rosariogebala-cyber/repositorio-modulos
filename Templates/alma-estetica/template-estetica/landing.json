  "estilo": ":root {\n  --ink: #3a2630; --green: #b4627a; --green-deep: #8e4660; --muted: #7b6870;\n  --line: #eedde2; --sage: #fbf2f4; --sage-2: #f6e7eb; --paper: #fcf6f4;\n  --cream: #f7ece8; --dark: #4b2d3b; --darker: #2b1922;\n  --shadow: 0 14px 40px rgba(58, 38, 48, 0.08);\n}\n.btn-nx-outline { border-color: #e3b3c1; }\n.btn-nx:hover { box-shadow: 0 10px 22px rgba(180, 98, 122, 0.22); }\n.plan-card .plan-badge { box-shadow: 0 6px 14px rgba(180, 98, 122, 0.25); }\n.plan-card.is-featured { box-shadow: 0 0 0 1.5px var(--green), 0 22px 44px rgba(58, 38, 48, 0.14); }\n.nx-stars { color: #d49aab; }\n.nav-dark-wrap { background: var(--darker); }\n.nav-dark-wrap::after { background: rgba(43, 25, 34, 0.74); }\n.nx-nav-dark { background: rgba(43, 25, 34, 0.72); }\n.nx-hero-slide { background-color: var(--paper); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(252, 246, 244, 0.9) 0%, rgba(252, 246, 244, 0.66) 32%, rgba(252, 246, 244, 0.14) 56%, rgba(252, 246, 244, 0) 70%);\n}\n.nx-footer-dark, .nx-footer-dark a { color: #f7ece8; }\n.nx-footer-dark .muted { color: #d9bfc8; }\n.foot-cta {\n  background:\n    radial-gradient(60% 120% at 88% 0%, rgba(180, 98, 122, 0.5) 0%, transparent 60%),\n    radial-gradient(50% 110% at 6% 100%, rgba(242, 188, 203, 0.3) 0%, transparent 60%),\n    linear-gradient(115deg, var(--darker) 0%, var(--dark) 55%, var(--green-deep) 100%);\n}\n.foot-cta h2 .em { color: #f2bccb; }\n.foot-cta p, .foot-form input::placeholder, .foot-form-note { color: #d9bfc8; }\n.bk-steps .is-done button, .bk-pro:hover { border-color: #e3b3c1; }\n.bk-steps .is-done span { background: #f5dde4; }\n.bk-pro[aria-pressed=\"true\"] { background: var(--sage); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(252, 246, 244, 0.95) 0%, rgba(252, 246, 244, 0.84) 36%, rgba(252, 246, 244, 0.32) 60%, rgba(252, 246, 244, 0) 80%);\n  }\n}"
