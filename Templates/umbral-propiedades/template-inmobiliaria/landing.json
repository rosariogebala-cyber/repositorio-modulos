  "estilo": ":root {\n  --ink: #14262a; --green: #1d5c63; --green-deep: #154549; --muted: #5b6b6e;\n  --line: #d9e3e4; --sage: #f0f5f5; --sage-2: #e5eeee; --paper: #f6f8f7;\n  --cream: #eef3f2; --dark: #173338; --darker: #0e2023;\n  --shadow: 0 14px 40px rgba(20, 38, 42, 0.08);\n}\n.btn-nx-outline { border-color: #a9c6c9; }\n.btn-nx:hover { box-shadow: 0 10px 22px rgba(29, 92, 99, 0.22); }\n.plan-card .plan-badge { box-shadow: 0 6px 14px rgba(29, 92, 99, 0.25); }\n.plan-card.is-featured { box-shadow: 0 0 0 1.5px var(--green), 0 22px 44px rgba(20, 38, 42, 0.14); }\n.nx-stars { color: #8fb3b7; }\n.nav-dark-wrap { background: var(--darker); }\n.nav-dark-wrap::after { background: rgba(14, 32, 35, 0.74); }\n.nx-nav-dark { background: rgba(14, 32, 35, 0.72); }\n.nx-hero-slide { background-color: var(--paper); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(246, 248, 247, 0.9) 0%, rgba(246, 248, 247, 0.66) 32%, rgba(246, 248, 247, 0.14) 56%, rgba(246, 248, 247, 0) 70%);\n}\n.nx-footer-dark, .nx-footer-dark a { color: #eef3f2; }\n.nx-footer-dark .muted { color: #a9bfc1; }\n.foot-cta {\n  background:\n    radial-gradient(60% 120% at 88% 0%, rgba(29, 92, 99, 0.5) 0%, transparent 60%),\n    radial-gradient(50% 110% at 6% 100%, rgba(230, 185, 128, 0.3) 0%, transparent 60%),\n    linear-gradient(115deg, var(--darker) 0%, var(--dark) 55%, var(--green-deep) 100%);\n}\n.foot-cta h2 .em { color: #e6b980; }\n.foot-cta p, .foot-form input::placeholder, .foot-form-note { color: #a9bfc1; }\n.bk-steps .is-done button, .bk-pro:hover { border-color: #a9c6c9; }\n.bk-steps .is-done span { background: #d7e7e8; }\n.bk-pro[aria-pressed=\"true\"] { background: var(--sage); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(246, 248, 247, 0.95) 0%, rgba(246, 248, 247, 0.84) 36%, rgba(246, 248, 247, 0.32) 60%, rgba(246, 248, 247, 0) 80%);\n  }\n}\n@media (min-width: 768px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(90deg, rgba(246, 248, 247, 0.96) 0%, rgba(246, 248, 247, 0.9) 36%, rgba(246, 248, 247, 0.45) 56%, rgba(246, 248, 247, 0) 72%);\n  }\n}"
