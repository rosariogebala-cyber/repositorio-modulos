  "estilo": ":root {\n  --ink: #1d1a17; --green: #b0703a; --green-deep: #8a5527; --muted: #6d655c;\n  --line: #e4dcd1; --sage: #f4efe8; --sage-2: #ede5da; --paper: #f7f3ed;\n  --cream: #efe7db; --dark: #1e1a16; --darker: #12100e;\n  --shadow: 0 14px 40px rgba(29, 26, 23, 0.08);\n}\n.btn-nx-outline { border-color: #d8b896; }\n.btn-nx:hover { box-shadow: 0 10px 22px rgba(176, 112, 58, 0.22); }\n.plan-card .plan-badge { box-shadow: 0 6px 14px rgba(176, 112, 58, 0.25); }\n.plan-card.is-featured { box-shadow: 0 0 0 1.5px var(--green), 0 22px 44px rgba(29, 26, 23, 0.14); }\n.nx-stars { color: #c9a27a; }\n.nav-dark-wrap { background: var(--darker); }\n.nav-dark-wrap::after { background: rgba(18, 16, 14, 0.74); }\n.nx-nav-dark { background: rgba(18, 16, 14, 0.72); }\n.nx-hero-slide { background-color: var(--paper); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(247, 243, 237, 0.9) 0%, rgba(247, 243, 237, 0.66) 32%, rgba(247, 243, 237, 0.14) 56%, rgba(247, 243, 237, 0) 70%);\n}\n.nx-footer-dark, .nx-footer-dark a { color: #efe7db; }\n.nx-footer-dark .muted { color: #b8ab9c; }\n.foot-cta {\n  background:\n    radial-gradient(60% 120% at 88% 0%, rgba(176, 112, 58, 0.5) 0%, transparent 60%),\n    radial-gradient(50% 110% at 6% 100%, rgba(226, 173, 120, 0.3) 0%, transparent 60%),\n    linear-gradient(115deg, var(--darker) 0%, var(--dark) 55%, var(--green-deep) 100%);\n}\n.foot-cta h2 .em { color: #e2ad78; }\n.foot-cta p, .foot-form input::placeholder, .foot-form-note { color: #b8ab9c; }\n.bk-steps .is-done button, .bk-pro:hover { border-color: #d8b896; }\n.bk-steps .is-done span { background: #f0e2d1; }\n.bk-pro[aria-pressed=\"true\"] { background: var(--sage); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(247, 243, 237, 0.95) 0%, rgba(247, 243, 237, 0.84) 36%, rgba(247, 243, 237, 0.32) 60%, rgba(247, 243, 237, 0) 80%);\n  }\n}\n.nav-dark-wrap::before { background-image: url(\"img/rubros/barberia/hero-2.jpg\"); }\n.nx-hero { background: var(--darker); }\n.nx-hero-slide { background-color: var(--darker); }\n.nx-hero .nx-hero-slide::before {\n  background: linear-gradient(90deg, rgba(18, 16, 14, 0.94) 0%, rgba(18, 16, 14, 0.74) 34%, rgba(18, 16, 14, 0.2) 60%, rgba(18, 16, 14, 0) 74%);\n}\n.nx-hero .nx-display { color: #fff; }\n.nx-hero .nx-display .em { color: #e2ad78; }\n.nx-hero .nx-lead { color: rgba(255, 255, 255, 0.78); }\n@media (max-width: 767.98px) {\n  .nx-hero .nx-hero-slide::before {\n    background: linear-gradient(180deg, rgba(18, 16, 14, 0.95) 0%, rgba(18, 16, 14, 0.82) 38%, rgba(18, 16, 14, 0.35) 62%, rgba(18, 16, 14, 0.1) 82%);\n  }\n}"
